fn repo_json_url_default() -> string is
    return "https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Package-Manager/main/repo/repo.json"
end

fn cache_ttl_secs() -> int is return 3600 end

fn allowed_schemes() -> [string] is
    return ["https://", "http://", "ssh://", "git@"]
end

fn meta_cache_dir() -> string is
    return paths::cache_dir() + "/meta"

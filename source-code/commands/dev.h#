fn test_solver_conflict_resolution() -> string is
    let pkg_a_v2: manifest::Manifest = with_conflicts(manifest::default_manifest("pkg-a"), ["pkg-b"])
    let pkg_a_v1: manifest::Manifest = manifest::default_manifest("pkg-a")
    let pkg_b_v1: manifest::Manifest = manifest::default_manifest("pkg-b")

    let candidates: [installer::PkgCandidates] = [
        installer::PkgCandidates { name: "pkg-a", versions: ["2.0.0", "1.0.0"], manifests: [pkg_a_v2, pkg_a_v1] },
        installer::PkgCandidates { name: "pkg-b", versions: ["1.0.0"], manifests: [pkg_b_v1] },
    ]
    let order: [string] = ["pkg-a", "pkg-b"]
    let s: state::State = state::state_new()
    let result: installer::SolveResult = installer::backtrack_solve(order, 0, candidates, s, [], 2000)

    if !result.solved is return "solver should find a conflict-free combination" end
    let a_ver: string = installer::assignment_version_of(result.assignment, "pkg-a")
    if a_ver != "1.0.0" is return "solver should have backed off pkg-a to 1.0.0 to avoid the conflict, got " + a_ver end
    let b_ver: string = installer::assignment_version_of(result.assignment, "pkg-b")
    if b_ver != "1.0.0" is return "expected pkg-b@1.0.0, got " + b_ver end
    return ""
end

fn test_solver_unsatisfiable() -> string is
    let pkg_a: manifest::Manifest = with_conflicts(manifest::default_manifest("pkg-a"), ["pkg-b"])
    let pkg_b: manifest::Manifest = manifest::default_manifest("pkg-b")
    let candidates: [installer::PkgCandidates] = [
        installer::PkgCandidates { name: "pkg-a", versions: ["1.0.0"], manifests: [pkg_a] },
        installer::PkgCandidates { name: "pkg-b", versions: ["1.0.0"], manifests: [pkg_b] },
    ]
    let order: [string] = ["pkg-a", "pkg-b"]
    let s: state::State = state::state_new()
    let result: installer::SolveResult = installer::backtrack_solve(order, 0, candidates, s, [], 2000)
    if result.solved is return "solver must report failure, not silently pick a conflicting combination" end
    return ""
end

fn with_conflicts(m: manifest::Manifest, conflicts: [string]) -> manifest::Manifest is
    let mut m2: manifest::Manifest = m
    m2.conflicts = conflicts
    return m2
end

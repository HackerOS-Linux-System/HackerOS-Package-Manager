fn test_diff_manifests(root: string) -> string is
    let dir1: string = make_pkg_dir(root, "diff-pkg", "1.0.0", "")
    let dir2: string = root + "/diff-pkg-2.0.0"
    utils::mkdir_all(dir2)
    fs::write(dir2 + "/info.hk", "[metadata]\n-> name => diff-pkg\n-> version => 2.0.0\n-> authors => New\n-> license => MIT\n" +
        "\n[description]\n-> summary => Changed\n" +
        "[sandbox]\n-> network => true\n-> gui => false\n-> full_gui => false\n-> dev => false\n-> disabled => false\n-> filesystem => []\n")
    let m1r: error::HpmResult<manifest::Manifest> = manifest::Manifest::load_from_path(dir1)
    let m2r: error::HpmResult<manifest::Manifest> = manifest::Manifest::load_from_path(dir2)
    match m1r is
        HpmResult::Err(e) => return "m1 failed: " + error::message(e)
        HpmResult::Ok(m1) => is
            match m2r is
                HpmResult::Err(e) => return "m2 failed: " + error::message(e)
                HpmResult::Ok(m2) => is
                    if m1.version == m2.version is return "versions should differ" end
                    if m1.sandbox.network == m2.sandbox.network is return "sandbox.network should differ" end
                    return ""
                end
            end
        end
    end
end


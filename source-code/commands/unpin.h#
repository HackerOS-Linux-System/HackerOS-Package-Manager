mod colors
mod error
mod utils
mod state
mod paths

use "std -> fmt" from "fmt"

pub fn unpin(package: string) -> error::HpmResult<bool> is
    let lock_r: error::HpmResult<int> = utils::acquire_lock()
    match lock_r is
        HpmResult::Err(e) => return error::HpmResult::Err(e)
        HpmResult::Ok(lock_fd) => is
            let result: error::HpmResult<bool> = unpin_inner(package)
            utils::release_lock(lock_fd)
            return result
        end
    end
end

fn unpin_inner(package: string) -> error::HpmResult<bool> is
    let s_r: error::HpmResult<state::State> = state::state_load()
    match s_r is
        HpmResult::Err(e) => return error::HpmResult::Err(e)
        HpmResult::Ok(s) => is
            let current_ver: string = state::get_current_version(package, paths::store_path())
            if current_ver == "" is
                return error::HpmResult::Err(error::HpmError::PackageNotFound(package))
            end
            let idx: int = state::find_index(s.packages, package, current_ver)
            if idx < 0 is
                return error::HpmResult::Err(error::HpmError::Manifest("Current version not found in state"))
            end
            let mut new_packages: [state::VersionInfo] = s.packages
            let mut info: state::VersionInfo = new_packages[idx]
            info.pinned = false
            new_packages[idx] = info
            let new_state: state::State = state::State { packages: new_packages, history: s.history }
            let save_r: error::HpmResult<bool> = state::state_save(new_state)
            if error::is_err(save_r) is return save_r end
            write(fmt::red("✔") + " Unpinned " + colors::white(package) + " (current version " + colors::white(current_ver) + ")")
            return error::HpmResult::Ok(true)
        end
    end
end

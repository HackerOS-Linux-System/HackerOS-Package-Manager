mod colors
mod error
mod repo
mod state
mod paths
mod utils

use "std -> fmt" from "fmt"

pub fn outdated() -> error::HpmResult<bool> is
    let rm_r: error::HpmResult<repo::RepoManager> = repo::repo_manager_load()
    match rm_r is
        HpmResult::Err(e) => return error::HpmResult::Err(e)
        HpmResult::Ok(rm) => is
            let s_r: error::HpmResult<state::State> = state::state_load()
            match s_r is
                HpmResult::Err(e) => return error::HpmResult::Err(e)
                HpmResult::Ok(s) => is
                    let mut names: [string] = []
                    let mut i: int = 0
                    while i < array_len(s.packages) is
                        if !contains_str(names, s.packages[i].name) is names = array_push(names, s.packages[i].name) end
                        i += 1
                    end

                    let mut outdated_names: [string] = []
                    let mut outdated_cur: [string] = []
                    let mut outdated_latest: [string] = []

                    let mut n: int = 0
                    while n < array_len(names) is
                        let pkg_name: string = names[n]
                        let current_ver: string = state::get_current_version(pkg_name, paths::store_path())
                        if current_ver != "" is
                            let idx: int = state::find_index(s.packages, pkg_name, current_ver)
                            let is_pinned: bool = idx >= 0 && s.packages[idx].pinned
                            if !is_pinned is
                                let meta_r: error::HpmResult<repo::PackageMeta> = repo::fetch_package_meta(rm, pkg_name)
                                match meta_r is
                                    HpmResult::Ok(meta) => is
                                        if meta.version != "" && utils::compare_versions(meta.version, current_ver) > 0 is
                                            outdated_names = array_push(outdated_names, pkg_name)
                                            outdated_cur = array_push(outdated_cur, current_ver)
                                            outdated_latest = array_push(outdated_latest, meta.version)
                                        end
                                    end
                                    HpmResult::Err(_) => is end
                                end
                            end
                        end
                        n += 1
                    end

                    if array_len(outdated_names) == 0 is
                        write("✔ All packages are up to date.")
                    else is
                        write("→ Outdated packages:\n")
                        write("  Package              Current         Latest")
                        write("  " + repeat_char("─", 55))
                        let mut o: int = 0
                        while o < array_len(outdated_names) is
                            write("  " + colors::magenta(outdated_names[o]) + "  " + fmt::red(outdated_cur[o]) + "  " + fmt::red(outdated_latest[o]))
                            o += 1
                        end
                        write("")
                        write("  Run " + fmt::dim("hpm update") + " to update all.")
                    end
                    return error::HpmResult::Ok(true)
                end
            end
        end
    end
end

fn contains_str(arr: [string], target: string) -> bool is
    let mut i: int = 0
    while i < array_len(arr) is
        if arr[i] == target is return true end
        i += 1
    end
    return false
end

fn repeat_char(c: string, n: int) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < n is
        out = out + c
        i += 1
    end
    return out
end

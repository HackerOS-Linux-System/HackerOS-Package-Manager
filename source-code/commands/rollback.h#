use "std -> fs"   from "fs"
use "std -> fmt"  from "fmt"
use "std -> io"   from "io"
use "std -> time" from "time"

pub fn rollback(package: string) -> error::HpmResult<bool> is
    let lock_r: error::HpmResult<int> = utils::acquire_lock()
    match lock_r is
        HpmResult::Err(e) => return error::HpmResult::Err(e)
        HpmResult::Ok(lock_fd) => is
            let result: error::HpmResult<bool> = rollback_dispatch(package)
            utils::release_lock(lock_fd)
            return result
        end
    end
end

fn rollback_dispatch(package: string) -> error::HpmResult<bool> is
    let s_r: error::HpmResult<state::State> = state::state_load()
    match s_r is
        HpmResult::Err(e) => return error::HpmResult::Err(e)
        HpmResult::Ok(s) => is
            let mut result: error::HpmResult<bool> = error::HpmResult::Ok(true)
            let mut final_state: state::State = s
            if package != "" is
                let r: error::HpmResult<state::State> = rollback_single_package(package, s)
                match r is
                    HpmResult::Ok(new_s) => is final_state = new_s result = error::HpmResult::Ok(true) end
                    HpmResult::Err(e)    => result = error::HpmResult::Err(e)
                end
            else is
                let r: error::HpmResult<state::State> = rollback_full_state(s)
                match r is
                    HpmResult::Ok(new_s) => is final_state = new_s result = error::HpmResult::Ok(true) end
                    HpmResult::Err(e)    => result = error::HpmResult::Err(e)
                end
            end
            if error::is_ok(result) is
                let save_r: error::HpmResult<bool> = state::state_save(final_state)
                if error::is_err(save_r) is return save_r end
            end
            return result
        end
    end
end

fn collect_bin_names_from_dir(dir: string) -> [string] is
    if !fs::exists(dir) is return [] end
    let mr: error::HpmResult<manifest::Manifest> = manifest::Manifest::load_from_path(dir)
    match mr is
        HpmResult::Ok(m) => return m.bins
        HpmResult::Err(_) => return []
    end
end

fn remove_all_wrappers_for_package(pkg_name: string) is
    let usr_bin: string = paths::bin_dir()
    if !fs::exists(usr_bin) is return end
    let entries: [string] = fs::list_dir(usr_bin)
    let mut i: int = 0
    while i < array_len(entries) is
        let path: string = usr_bin + "/" + entries[i]
        if fs::is_file(path) is
            let content: string = fs::read(path)
            if string_contains(content, "hpm run ") is
                let lines: [string] = string_split(content, "\n")
                let mut l: int = 0
                let mut matched: bool = false
                while l < array_len(lines) && !matched is
                    let line: string = lines[l]
                    if string_starts_with(line, "exec ") is
                        let rest: string = string_slice(line, 5, string_len(line))
                        let parts: [string] = string_split(string_trim(rest), " ")
                        if array_len(parts) >= 3 && parts[1] == "run" && parts[2] == pkg_name is
                            fs::remove(path)
                            matched = true
                        end
                    end
                    l += 1
                end
            end
        end
        i += 1
    end
end

fn rollback_single_package(pkg_name: string, s: state::State) -> error::HpmResult<state::State> is
    let prev_ver: string = state::get_previous_version(s, pkg_name, paths::store_path())
    if prev_ver == "" is
        return error::HpmResult::Err(error::HpmError::Manifest(
            "No previous version found for '" + pkg_name + "'.\n" +
            "Only one version is installed — nothing to roll back to."))
    end

    let current_ver: string = state::get_current_version(pkg_name, paths::store_path())
    write("→ Rolling back " + colors::white(pkg_name) + " from " + colors::white(current_ver) + " to " + colors::white(prev_ver))

    let pkg_dir: string = paths::store_path() + pkg_name
    let prev_dir: string = pkg_dir + "/" + prev_ver

    if !fs::exists(prev_dir) is
        return error::HpmResult::Err(error::HpmError::Manifest(
            "Version " + pkg_name + "@" + prev_ver + " files not found in store.\n" +
            "Run " + fmt::dim("hpm doctor") + " to diagnose."))
    end

    let current_dir: string = pkg_dir + "/" + current_ver
    let current_bins: [string] = collect_bin_names_from_dir(current_dir)
    let mut i: int = 0
    while i < array_len(current_bins) is
        let wrapper: string = paths::bin_dir() + "/" + current_bins[i]
        if fs::exists(wrapper) is
            let content: string = fs::read(wrapper)
            if string_contains(content, "hpm run ") is fs::remove(wrapper) end
        end
        i += 1
    end
    remove_all_wrappers_for_package(pkg_name)

    let set_r: error::HpmResult<bool> = utils::set_current_version(pkg_dir, prev_ver)
    if error::is_err(set_r) is
        match set_r is
            HpmResult::Err(e) => return error::HpmResult::Err(e)
            HpmResult::Ok(_)  => is end
        end
    end

    squash::ensure_mounted(prev_dir)
    let hpm_exe: string = installer::which_hpm_for_wrappers()

    let mr: error::HpmResult<manifest::Manifest> = manifest::Manifest::load_from_path(prev_dir)
    match mr is
        HpmResult::Ok(m) => is
            let mut b: int = 0
            while b < array_len(m.bins) is
                let bin_name: string = m.bins[b]
                let mut bin_rel: string = ""
                if manifest::osm_contains(m.bin_paths, bin_name) is
                    let explicit: string = manifest::osm_get(m.bin_paths, bin_name)
                    if fs::exists(prev_dir + "/" + explicit) is bin_rel = explicit end
                else is
                    bin_rel = installer::find_binary_in_dir(prev_dir, bin_name)
                end

                if bin_rel != "" is
                    let wrapper_path: string = paths::bin_dir() + "/" + bin_name
                    let content: string = "#!/bin/sh\nexec " + hpm_exe + " run " + pkg_name + " " + bin_rel + " \"$@\"\n"
                    fs::write(wrapper_path, content)
                    utils::make_executable(wrapper_path)
                    write("  ✔ Wrapper: " + paths::bin_dir() + "/" + colors::white(bin_name) + " → " + pkg_name + "@" + prev_ver + "/" + fmt::dim(bin_rel))
                else is
                    write("  ⚠ Binary '" + bin_name + "' not found in " + pkg_name + "@" + prev_ver)
                end
                b += 1
            end

            if m.is_gui || m.sandbox.gui || m.sandbox.full_gui is
                installer::install_desktop_integration_pub(prev_dir, m, pkg_name, hpm_exe)
            end
        end
        HpmResult::Err(_) => is end
    end

    write(fmt::red("✔") + " " + colors::white(pkg_name) + "@" + colors::white(prev_ver) + " is now the current version")
    return error::HpmResult::Ok(s)
end

fn rollback_full_state(s: state::State) -> error::HpmResult<state::State> is
    let history: [state::RollbackEntry] = state::list_history(s)

    if array_len(history) == 0 is
        write("→ No rollback history available.")
        write("  History is recorded automatically before install/update/remove operations.")
        return error::HpmResult::Ok(s)
    end

    write("→ Rollback history (most recent last):\n")
    let mut i: int = 0
    while i < array_len(history) is
        let dt: string = time::format(history[i].timestamp, "%Y-%m-%d %H:%M")
        write("  [" + colors::white(to_string(i)) + "]  " + fmt::dim(dt) + "  " + history[i].description)
        i += 1
    end

    write("")
    let input: string = string_trim(io::read_line("Enter snapshot index to restore (or 'q' to quit): "))
    if string_lower(input) == "q" || input == "" is
        write("→ Aborted.")
        return error::HpmResult::Ok(s)
    end

    let index_opt: int? = parse_int(input)
    if index_opt == nil is
        return error::HpmResult::Err(error::HpmError::InvalidArg("Invalid index: " + input))
    end
    let index: int = index_opt
    if index < 0 || index >= array_len(history) is
        return error::HpmResult::Err(error::HpmError::InvalidArg("Index " + to_string(index) + " out of range (0.." + to_string(array_len(history) - 1) + ")"))
    end

    let snapshot_desc: string = history[index].description
    write("\n→ Restoring to: " + snapshot_desc)

    let target_snapshot: [state::VersionInfo] = history[index].snapshot
    let current_pkgs: [state::VersionInfo] = s.packages

    let mut to_install: [state::VersionInfo] = []
    let mut ti: int = 0
    while ti < array_len(target_snapshot) is
        let t: state::VersionInfo = target_snapshot[ti]
        if state::find_index(current_pkgs, t.name, t.version) < 0 is
            to_install = array_push(to_install, t)
        end
        ti += 1
    end

    let mut to_remove: [state::VersionInfo] = []
    let mut ci: int = 0
    while ci < array_len(current_pkgs) is
        let c: state::VersionInfo = current_pkgs[ci]
        if state::find_index(target_snapshot, c.name, c.version) < 0 is
            to_remove = array_push(to_remove, c)
        end
        ci += 1
    end

    if array_len(to_install) == 0 && array_len(to_remove) == 0 is
        write(fmt::red("✔") + " Current state matches the selected snapshot. Nothing to do.")
        return error::HpmResult::Ok(s)
    end

    if array_len(to_install) > 0 is
        write("\n  Packages to reinstall (files must already be in store):")
        let mut ii: int = 0
        while ii < array_len(to_install) is
            write("    + " + colors::white(to_install[ii].name) + "@" + to_install[ii].version)
            ii += 1
        end
    end
    if array_len(to_remove) > 0 is
        write("\n  Packages to remove:")
        let mut ri: int = 0
        while ri < array_len(to_remove) is
            write("    – " + colors::white(to_remove[ri].name) + "@" + to_remove[ri].version)
            ri += 1
        end
    end

    write("")
    let confirm: string = io::read_line("Proceed? [y/N] ")
    if string_lower(string_trim(confirm)) != "y" is
        write("→ Aborted.")
        return error::HpmResult::Ok(s)
    end

    let mut new_s: state::State = s
    let mut ri2: int = 0
    while ri2 < array_len(to_remove) is
        let r: state::VersionInfo = to_remove[ri2]
        let pkg_path: string = paths::store_path() + r.name + "/" + r.version
        if fs::exists(pkg_path) is
            let rr: error::HpmResult<state::State> = remove::remove_version(r.name, r.version, new_s)
            match rr is
                HpmResult::Ok(s2) => is new_s = s2 write("  ✔ Removed " + colors::white(r.name) + "@" + r.version) end
                HpmResult::Err(e) => return error::HpmResult::Err(e)
            end
        end
        ri2 += 1
    end

    let mut ii2: int = 0
    while ii2 < array_len(to_install) is
        let t: state::VersionInfo = to_install[ii2]
        let pkg_path: string = paths::store_path() + t.name + "/" + t.version
        if fs::exists(pkg_path) is
            let pkg_dir: string = paths::store_path() + t.name
            utils::set_current_version(pkg_dir, t.version)
            write("  ✔ Restored " + colors::white(t.name) + "@" + t.version + " (files in store)")
        else is
            write("  ⚠ " + colors::white(t.name) + "@" + t.version + " not in store — reinstall manually: " +
                fmt::dim("hpm install " + t.name + "@" + t.version))
        end
        ii2 += 1
    end

    new_s = state::restore_snapshot(new_s, index)
    write("\n" + fmt::red("✔") + " Rollback complete.")
    return error::HpmResult::Ok(new_s)
end

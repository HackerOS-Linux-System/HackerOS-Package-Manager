[package]
-> name        => hpm
-> version     => 1.0.0
-> description => HackerOS Package Manager — zarzadzanie pakietami bez roota
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0
-> lang        => h#

[layout]
-> src => source-code

[build]
-> link => static

[default-build]
-> profile => release
-> target  => h#
-> emit    => bin

[dependencies]
-> nidus        => newest
-> landlock     => newest
-> libseccomp   => newest
-> progress-bar => newest

[commands]
-> check
--> run => bit check
--> description => Type-check every module
-> install-local
--> run => install -Dm755 cache/build/release/hpm /usr/bin/hpm
--> description => Install the release binary to /usr/bin

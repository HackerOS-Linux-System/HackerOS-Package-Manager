[metadata]
-> name    => hello-hpm
-> version => 1.0.0
-> authors => HackerOS Team <hackeros068@gmail.com>
-> license => MIT
-> bins.hello-hpm => "bin/hello-hpm"
-> tags => [
    "demo"
    "cli"
    "example"
]

[description]
-> summary => A simple hello-world demo package for HackerOS Package Manager
-> long    => This package demonstrates the minimal structure required for an hpm package.
              It includes a prebuilt shell script binary, a proper info.hk manifest,
              and serves as a reference for package authors getting started with hpm.

[specs]
-> arch => x86_64
-> min_kernel => 5.4

[sandbox]
-> network   => false
-> gui       => false
-> full_gui  => false
-> dev       => false
-> disabled  => false
-> filesystem => []

[build]
-> commands => []
-> deb_deps => []

[runtime]
-> deb_deps => []
